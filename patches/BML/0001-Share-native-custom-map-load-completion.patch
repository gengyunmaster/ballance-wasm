diff --git a/src/CustomMaps/CustomMapLoad.cpp b/src/CustomMaps/CustomMapLoad.cpp
new file mode 100644
index 00000000..8179e722
--- /dev/null
+++ b/src/CustomMaps/CustomMapLoad.cpp
@@ -0,0 +1,46 @@
+#include "CustomMaps/CustomMapLoad.h"
+
+#include "Loader/ModContext.h"
+
+#include <vector>
+
+namespace CustomMapLoad {
+bool ReadName(const BML_DataShare *share, std::string &name) {
+    std::size_t size = 0;
+    (void) BML_DataShare_CopyEx(share, NameKey, nullptr, 0, &size);
+    for (int retry = 0; retry != 3 && size != 0; ++retry) {
+        std::vector<char> buffer(size, '\0');
+        std::size_t copiedSize = 0;
+        const int copied = BML_DataShare_CopyEx(
+            share, NameKey, buffer.data(), buffer.size(), &copiedSize);
+        if (copied == 1 && copiedSize == buffer.size() && buffer.back() == '\0') {
+            name.assign(buffer.data(), buffer.size() - 1u);
+            return true;
+        }
+        size = copiedSize;
+    }
+    return false;
+}
+
+bool CompleteRequest(ModContext &context, bool isMap, bool loaded,
+                     const std::string &fallbackName, std::string &callbackName) {
+    callbackName = fallbackName;
+    if (!isMap)
+        return false;
+
+    BML_DataShare *share = context.GetDataShare();
+    Request request;
+    if (!share || !ReadRequest(share, request))
+        return false;
+
+    (void) ReadName(share, callbackName);
+    if (!WriteResult(share, request.Attempt,
+                     loaded ? Outcome::Loaded : Outcome::Failed)) {
+        if (ILogger *logger = context.GetLogger())
+            logger->Error("Failed to publish custom map Object Load result");
+    }
+    BML_DataShare_Remove(share, RequestKey);
+    BML_DataShare_Remove(share, NameKey);
+    return true;
+}
+}
