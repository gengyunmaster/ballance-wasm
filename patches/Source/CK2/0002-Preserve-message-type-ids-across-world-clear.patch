+TEST_F(CKMessageContractTest, ClearAllKeepsMessageTypeIdsAndDeletionNotificationsUsable) {
+    CKMessageManager *manager = Context->GetMessageManager();
+    ASSERT_NE(nullptr, manager);
+    const CKMessageType type = manager->AddMessageType(const_cast<char *>("ModLifecycleEvent"));
+    ASSERT_GE(type, 0);
+    CKBeObject *object = Object("temporary object");
+    ASSERT_NE(nullptr, object);
+    CK_ID objectId = object->GetID();
+
+    ASSERT_EQ(CK_OK, Context->ClearAll());
+    EXPECT_EQ(type, manager->AddMessageType(const_cast<char *>("ModLifecycleEvent")));
+    EXPECT_EQ(CK_OK, manager->SequenceToBeDeleted(&objectId, 1));
+}
