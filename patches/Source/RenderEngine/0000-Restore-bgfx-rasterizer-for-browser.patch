diff --git a/cmake/CKREBgfx.cmake b/cmake/CKREBgfx.cmake
new file mode 100644
index 00000000..696d2fdc
--- /dev/null
+++ b/cmake/CKREBgfx.cmake
@@ -0,0 +1,47 @@
+include_guard(GLOBAL)
+
+# Every archive uses the same population policy. Keep revisions and hashes at
+# the call sites so dependency updates remain directly reviewable.
+function(_ckre_declare_bgfx_archive NAME REPOSITORY REVISION SHA256)
+    if (POLICY CMP0135)
+        cmake_policy(SET CMP0135 NEW)
+    endif ()
+    set(_patch_command)
+    if (NAME STREQUAL "ckre_bgfx" AND EMSCRIPTEN)
+        set(_patch_command PATCH_COMMAND git apply "${BALLANCE_WASM_PATCH_ROOT}/bgfx/0001-Set-integer-defaults-for-missing-blend-indices.patch")
+    endif ()
+    FetchContent_Declare(${NAME}
+        URL "https://codeload.github.com/bkaradzic/${REPOSITORY}/tar.gz/${REVISION}"
+        URL_HASH "SHA256=${SHA256}"
+        SOURCE_SUBDIR .ckre-sources-only
+        ${_patch_command})
+endfunction()
+
+# Keep upstream sources outside the source tree. All four archives belong to
+# the same upstream bgfx.cmake revision.
+function(ckre_fetch_bgfx_sources)
+    if (NOT CKRE_BUILD_BGFX_RASTERIZER)
+        return()
+    endif ()
+    if (CMAKE_VERSION VERSION_LESS 3.20)
+        message(FATAL_ERROR "The optional bgfx build requires CMake 3.20 or newer")
+    endif ()
+    include(FetchContent)
+    _ckre_declare_bgfx_archive(ckre_bgfx_cmake bgfx.cmake
+        bc2f286a7ca98d435c7f3c3c43d8258246b17918
+        375fc9d5811690381154e036673a3127725a71e371c32d14e0ede61558df8ef0)
+    _ckre_declare_bgfx_archive(ckre_bgfx bgfx
+        c7684e20da1e385edc439ef39cdb42b8c661016f
+        2c473c1eae44ecc43f16e601c5228735c36c59dc0eaaf59e9faa0c703c6a4304)
+    _ckre_declare_bgfx_archive(ckre_bx bx
+        0b001f5f36579e8aea07efa5af139ca18dad9505
+        6838db5c4d78d2e901f3828ab7d4ee143f5c701a0ee6e1b7ab1f72a4fea12a6a)
+    _ckre_declare_bgfx_archive(ckre_bimg bimg
+        3b4baab0128ac499c5c3bc37202781bf54084049
+        e8cdb1ab4e17388cd560194d8372da4464fa72434d432fdcbae56be246d68a53)
+    FetchContent_MakeAvailable(ckre_bgfx_cmake ckre_bgfx ckre_bx ckre_bimg)
+    set(CKRE_BGFX_CMAKE_SOURCE_DIR "${ckre_bgfx_cmake_SOURCE_DIR}" PARENT_SCOPE)
+    set(BGFX_DIR "${ckre_bgfx_SOURCE_DIR}" PARENT_SCOPE)
+    set(BX_DIR "${ckre_bx_SOURCE_DIR}" PARENT_SCOPE)
+    set(BIMG_DIR "${ckre_bimg_SOURCE_DIR}" PARENT_SCOPE)
+endfunction()
diff --git a/cmake/CKREBrowserBgfx.cmake b/cmake/CKREBrowserBgfx.cmake
new file mode 100644
index 00000000..cfc4615a
--- /dev/null
+++ b/cmake/CKREBrowserBgfx.cmake
@@ -0,0 +1,57 @@
+include_guard(GLOBAL)
+
+function(ckre_restore_browser_bgfx_rasterizer)
+    if (NOT EMSCRIPTEN OR NOT CKRE_BUILD_BGFX_RASTERIZER)
+        return()
+    endif ()
+
+    include(FetchContent)
+    FetchContent_Declare(ckre_legacy_rasterizer
+        URL "https://codeload.github.com/doyaGu/CKRenderEngine/tar.gz/63863ff19e5578864f75b50b41c789372fc2e357"
+        URL_HASH "SHA256=650f63ac0e7247a541a4d430817ee8788ea439b9f25262ce298b4f3c6e5c1838"
+        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+        SOURCE_SUBDIR .legacy-rasterizer-only
+    )
+    FetchContent_MakeAvailable(ckre_legacy_rasterizer)
+
+    file(COPY "${ckre_legacy_rasterizer_SOURCE_DIR}/src/CKRasterizer/CKBgfxRasterizer"
+        DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/src/CKRasterizer")
+    file(COPY "${ckre_legacy_rasterizer_SOURCE_DIR}/tests/rasterizers/test_bgfx_rasterizer.cpp"
+        DESTINATION "${CMAKE_CURRENT_SOURCE_DIR}/tests/rasterizers")
+
+    foreach (patch_name IN ITEMS
+            0001-Pass-the-browser-canvas-to-bgfx.patch
+            0003-Support-opaque-texture-formats-in-bgfx.patch
+            0004-Allow-texture-uploads-without-native-blit.patch
+            0005-Cover-texture-channel-conversion.patch
+            0006-Adapt-bgfx-to-current-pipeline-state.patch
+            0007-Adapt-bgfx-to-current-sampler-abi.patch
+            0009-Restore-bgfx-shader-compatibility.patch
+            0010-Restore-bgfx-named-uniform-interface.patch
+            0011-Preserve-source-format-for-texture-uploads.patch)
+        execute_process(
+            COMMAND git apply --check "${CMAKE_SOURCE_DIR}/patches/Source/RenderEngine/${patch_name}"
+            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+            RESULT_VARIABLE patch_result
+            OUTPUT_QUIET ERROR_QUIET
+        )
+        if (patch_result EQUAL 0)
+            execute_process(
+                COMMAND git apply "${CMAKE_SOURCE_DIR}/patches/Source/RenderEngine/${patch_name}"
+                WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+                RESULT_VARIABLE patch_result
+                OUTPUT_QUIET ERROR_QUIET
+            )
+        else ()
+            execute_process(
+                COMMAND git apply -R --check "${CMAKE_SOURCE_DIR}/patches/Source/RenderEngine/${patch_name}"
+                WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+                RESULT_VARIABLE patch_result
+                OUTPUT_QUIET ERROR_QUIET
+            )
+        endif ()
+        if (NOT patch_result EQUAL 0)
+            message(FATAL_ERROR "Unable to apply browser rasterizer patch: ${patch_name}")
+        endif ()
+    endforeach ()
+endfunction()
