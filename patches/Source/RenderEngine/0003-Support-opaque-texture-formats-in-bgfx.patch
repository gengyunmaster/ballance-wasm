+static bool CKBgfxNeedsRedBlueSwap(VX_PIXELFORMAT source, bgfx::TextureFormat::Enum destination)
+{
+    if (source == _32_ARGB8888 || source == _32_RGB888)
+        return destination == bgfx::TextureFormat::RGBA8;
+    if (source == _32_ABGR8888 || source == _32_BGR888)
+        return destination == bgfx::TextureFormat::BGRA8;
+    return false;
+}
+
+void CKBgfxConvertTextureRows(const VxImageDescEx &data,
+                              uint16_t width, uint16_t height, CKDWORD pitch,
+                              CKBYTE *destination, CKDWORD destinationPitch,
+                              bool swapRedBlue)
+{
+    const CKDWORD rowBytes = (CKDWORD)width * (swapRedBlue ? 4u : (CKDWORD)data.BitsPerPixel / 8u);
+    for (uint16_t row = 0; row < height; ++row) {
+        const CKBYTE *source = static_cast<const CKBYTE *>(data.Image) + row * pitch;
+        if (!swapRedBlue) {
+            memcpy(destination, source, rowBytes);
+        } else {
+            for (uint16_t column = 0; column < width; ++column) {
+                destination[column * 4] = source[column * 4 + 2];
+                destination[column * 4 + 1] = source[column * 4 + 1];
+                destination[column * 4 + 2] = source[column * 4];
+                destination[column * 4 + 3] = source[column * 4 + 3];
+            }
+        }
+        destination += destinationPitch;
+    }
+}
+
+static const bgfx::Memory *CKBgfxCopyTextureRows(const VxImageDescEx &data,
+                                                 uint16_t width, uint16_t height,
+                                                 CKDWORD pitch, CKDWORD rowBytes,
+                                                 bool swapRedBlue)
+{
+    const bgfx::Memory *memory = bgfx::alloc(rowBytes * height);
+    CKBgfxConvertTextureRows(data, width, height, pitch, memory->data, rowBytes, swapRedBlue);
+    return memory;
+}
