+static void TestTextureRowConversion()
+{
+    TEST_SECTION("Texture Row Conversion");
+
+    const CKBYTE source[] = {
+        10, 20, 30, 255, 40, 50, 60, 128,
+        70, 80, 90, 255, 100, 110, 120, 128,
+    };
+    const CKBYTE expected[] = {
+        30, 20, 10, 255, 60, 50, 40, 128,
+        90, 80, 70, 255, 120, 110, 100, 128,
+    };
+    VxImageDescEx desc = {};
+    desc.Image = const_cast<CKBYTE *>(source);
+    desc.BitsPerPixel = 32;
+    CKBYTE converted[sizeof(source)] = {};
+    CKBgfxConvertTextureRows(desc, 2, 2, 8, converted, 8, true);
+    TEST_ASSERT(memcmp(converted, expected, sizeof(expected)) == 0,
+                "contiguous BGRA rows become RGBA");
+
+    const CKBYTE paddedSource[] = {
+        10, 20, 30, 255, 40, 50, 60, 128, 0, 0, 0, 0,
+        70, 80, 90, 255, 100, 110, 120, 128, 0, 0, 0, 0,
+    };
+    memset(converted, 0, sizeof(converted));
+    CKBgfxConvertTextureRows(desc, 2, 2, 8, converted, 8, false);
+    TEST_ASSERT(memcmp(converted, source, sizeof(source)) == 0,
+                "contiguous rows retain their bytes without conversion");
+    desc.Image = const_cast<CKBYTE *>(paddedSource);
+    memset(converted, 0, sizeof(converted));
+    CKBgfxConvertTextureRows(desc, 2, 2, 12, converted, 8, true);
+    TEST_ASSERT(memcmp(converted, expected, sizeof(expected)) == 0,
+                "row conversion respects source padding");
+}
