+bool CGamePlayer::HandleMouseClick(void *data, SDL_Event *event)
+{
+    if (event->type == SDL_EVENT_MOUSE_BUTTON_DOWN && event->button.button == SDL_BUTTON_LEFT)
+        static_cast<CGamePlayer *>(data)->OnClick(event->button.clicks >= 2);
+    return true;
+}
+
+#ifdef __EMSCRIPTEN__
+static void RunGamePlayerFrame(void *data)
+{
+    CGamePlayer *player = static_cast<CGamePlayer *>(data);
+    if (!player->Update())
+    {
+        emscripten_cancel_main_loop();
+        player->Shutdown();
+    }
+}
+#endif
+
 void CGamePlayer::Run()
 {
+    SDL_AddEventWatch(CGamePlayer::HandleMouseClick, this);
+#ifdef __EMSCRIPTEN__
+    emscripten_set_main_loop_arg(RunGamePlayerFrame, this, 0, 1);
+#else
     while (Update())
         continue;
+#endif
 }
 
