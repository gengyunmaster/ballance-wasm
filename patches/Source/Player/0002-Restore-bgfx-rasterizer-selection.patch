diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index e051c92..0c46894 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -9,8 +9,14 @@ set_property(GLOBAL PROPERTY PLAYER_RUNTIME_MODULES "${_player_runtime_modules}"

 # The default rasterizer follows the providers in this build. The generated
 # configuration header and the installed Player.ini share this value.
+set(_player_has_bgfx_rasterizer 0)
+if (TARGET CKBgfxRasterizer OR TARGET CKBgfxRasterizerStatic)
+    set(_player_has_bgfx_rasterizer 1)
+endif ()
 if (TARGET CKSdlGpuRasterizer)
     set(_player_default_rasterizer "sdlgpu")
+elseif (_player_has_bgfx_rasterizer)
+    set(_player_default_rasterizer "bgfx")
 else ()
     set(_player_default_rasterizer "null")
 endif ()
diff --git a/src/GameConfig.cpp b/src/GameConfig.cpp
index 00986a0..0123d7a 100644
--- a/src/GameConfig.cpp
+++ b/src/GameConfig.cpp
@@ -367,10 +367,11 @@ void CGameConfig::LoadFromIni(const char *filename)

     CaptureFieldValuesAsLoaded();

-    // The retired bgfx rasterizer selects the build's default; saving the
-    // configuration replaces it.
+#if !PLAYER_HAS_BGFX_RASTERIZER
+    // Without a bgfx provider, its legacy selection falls back to the default.
     if (rasterizer.Compare("bgfx") == 0)
         rasterizer = PLAYER_DEFAULT_RASTERIZER;
+#endif
 }

 bool CGameConfig::SaveToIni(const char *filename)
